type sysfs_performance, fs_type, sysfs_type;
allow system_server audioserver_tmpfs:file write;
allow system_server self:capability sys_module;
allow system_server sysfs_performance:file { write r_file_perms };

dontaudit system_server sysfs:file { getattr open read };
dontaudit system_server tmpfs:file write;
dontaudit system_server zygote_tmpfs:file write;
